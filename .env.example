# Market Monitor GUI — development overrides.
# Copy to `.env` for local use. NEVER commit real secrets.

# Environment name (diagnostics only for now).
APP_ENV=development

# Shared application secret, same value the control plane knows.
# Used only once for POST /api/v1/auth/app-login; the session then uses a cookie.
# Preferred name:
APP_SECRET=changeme_to_the_shared_app_secret
# Legacy alias accepted for compatibility (used only if APP_SECRET is unset):
#API_APP_KEY=changeme_to_the_shared_app_secret

# API origin ONLY: scheme + host (+ optional port), no path.
# A trailing `/api/v1` suffix is tolerated and stripped on load.
API_BASE_URL=https://api.market-resale-signal.xubi.org
